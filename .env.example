# PostgreSQL connection string
DATABASE_URL="postgresql://app:app@localhost:5432/inventory"
# Direct connection used for migrations (same as above when not using a pooler)
DATABASE_URL_UNPOOLED="postgresql://app:app@localhost:5432/inventory"
# Long random string used to sign login sessions
AUTH_SECRET="change-me-to-a-long-random-string"
# Password for the first admin account created by `npm run db:seed`
SEED_ADMIN_PASSWORD="change-me"
# Daily reminder mail (optional). Without RESEND_API_KEY no mail is sent.
# RESEND_API_KEY="re_..."            # from https://resend.com
# MAIL_FROM="庫存提醒 <stock@your-domain.com>"   # needs a domain verified in Resend; default is onboarding@resend.dev
# CRON_SECRET="long-random-string"   # Vercel Cron sends it to /api/cron/digest
# APP_URL="https://your-site"        # link in the mail
