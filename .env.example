# PostgreSQL connection string
DATABASE_URL="postgresql://app:app@localhost:5432/inventory"
# Direct connection used for migrations (same as above when not using a pooler)
DATABASE_URL_UNPOOLED="postgresql://app:app@localhost:5432/inventory"
# Long random string used to sign login sessions
AUTH_SECRET="change-me-to-a-long-random-string"
# Password for the first admin account created by `npm run db:seed`
SEED_ADMIN_PASSWORD="change-me"
